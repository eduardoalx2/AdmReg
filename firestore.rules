rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // --- COLEÇÕES PÚBLICAS (leitura sem login) ---

    // Agenda: exibida em páginas públicas (agendaregiao655.html, etc.)
    match /agenda/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Inscrições Dia das Crianças: públicas
    match /diadascriancas_inscricoes/{docId} {
      allow read, write: if true;
    }

    // Eventos: exibidos em páginas públicas
    match /eventos/{docId} {
      allow read: if true;
      allow write: if true;

      // Inscrições do evento (público pode criar, organizadores gerenciam)
      match /inscricoes/{inscricaoId} {
        allow read, write: if true;
      }

      // Despesas do evento
      match /despesas/{despesaId} {
        allow read, write: if true;
      }

      // Log de auditoria financeira (imutável contra edições, mas permite exclusão ao limpar evento)
      match /logs_financeiros/{logId} {
        allow read, create: if true;
        allow update: if false;
        allow delete: if true;
      }
    }

    // Igrejas: lidas na página pública de presença
    match /igrejas/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Pastores: lidos na página pública de presença
    match /pastores/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Seminários: lidos na página pública que gera os links do Roteiro
    // do Facilitador (cidadania2026). Escrita continua só autenticada.
    match /seminarios/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Configurações: layout_login e mini_portal são públicos
    match /configuracoes/{docId} {
      allow read: if docId == 'layout_login' || docId == 'mini_portal' || isAuthenticated();
      allow write: if isAuthenticated();
    }

    // --- PRESENÇAS: leitura e escrita públicas com validação de campos ---
    // A página presencareg655.html é acessível sem login
    match /presencas/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['nome', 'igreja', 'eventoId', 'status', 'declaracao'])
                    && request.resource.data.declaracao == 'Sim'
                    && request.resource.data.status in ['Presente', 'Justificado', 'Ausente'];
      allow update: if request.resource.data.keys().hasAll(['nome', 'igreja', 'eventoId', 'status', 'declaracao'])
                    && request.resource.data.declaracao == 'Sim'
                    && request.resource.data.status in ['Presente', 'Justificado', 'Ausente'];
      allow delete: if isAuthenticated();
    }

    // --- COLEÇÕES PRIVADAS (requerem autenticação) ---

    // Logs de Auditoria do Sistema: autenticado pode criar e ler; imutável (sem edição nem exclusão)
    match /logs_atividades/{docId} {
      allow read, create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    match /usuarios/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /recibos/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Números de recibos cancelados (excluídos): registro permanente, nunca reutilizados.
    // Pode ser lido e criado; não pode ser alterado nem apagado.
    match /recibos_numeros_cancelados/{docId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /saldos_virada/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /pendencias_manuais/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /coordenadorias/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /avisos/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /avisos_ciencia/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /checklist_caixa/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /checklist_observacoes/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /checklist_sgaf/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /coordenadores_cidadania/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /devolucao_9018/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Presenças de Evento Aberto: escrita pública com validação
    match /presencas_evento_aberto/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['eventoId', 'igrejaNome', 'qtdPessoas', 'nomeRegistrador'])
                    && request.resource.data.qtdPessoas is number
                    && request.resource.data.qtdPessoas >= 1;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Pedidos da Campanha Projeto de Vida 2027
    // Pedidos encerrados em 05/Nov: criação de novos pedidos bloqueada.
    // Leitura, edição (ex.: marcar pago) e exclusão continuam liberadas.
    match /pedidos_campanha_2027/{docId} {
      allow read, update, delete: if isAuthenticated();
      allow create: if false;
    }

    // --- VATHOS 2027 ---

    // Configurações do evento VATHOS 2027 (lotes, termos, flags "A definir", gestores)
    match /vathos_2027_config/{docId} {
      allow read, write: if true;
    }

    // Inscrições VATHOS 2027 (portal público consulta/cria/atualiza por CPF; administração autenticada ou via gestor)
    match /vathos_2027_inscricoes/{cpfId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['cpf', 'nomeCompleto', 'modalidade', 'statusCadastro', 'statusParticipacao'])
                    && request.resource.data.cpf is string
                    && request.resource.data.cpf.size() == 11;
      allow update: if (request.resource.data.cpf == resource.data.cpf) || isAuthenticated();
      allow delete: if true;
    }

    // Fichas de Saúde VATHOS 2027 (separadas das inscrições para privacidade na listagem de líderes)
    match /vathos_2027_fichas_saude/{cpfId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['cpf'])
                            && request.resource.data.cpf is string
                            && request.resource.data.cpf.size() == 11;
      allow delete: if true;
    }

    // Pagamentos individuais VATHOS 2027
    match /vathos_2027_pagamentos/{pagamentoId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['cpfParticipante', 'forma', 'valorDestinadoInscricao', 'statusConferencia'])
                    && request.resource.data.valorDestinadoInscricao is number
                    && request.resource.data.valorDestinadoInscricao >= 0;
      allow update: if true;
      allow delete: if true;
    }

    // Acertos financeiros coletivos/igreja VATHOS 2027
    match /vathos_2027_acertos/{acertoId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    // Despesas do evento VATHOS 2027 (custos da chácara, som, alimentação, notas fiscais, etc.)
    match /vathos_2027_despesas/{despesaId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    // Trilha de auditoria imutável VATHOS 2027
    match /vathos_2027_auditoria/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Qualquer outra coleção não listada: requer autenticação
    match /{collection}/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
