[debug] [2026-11-18T03:36:02.520Z] <<< [apiv2][status] POST https://firebaserules.googleapis.com/v1/projects/regiao655-admin/rulesets 200
[debug] [2026-11-18T03:36:02.520Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/regiao655-admin/rulesets {"name":"projects/regiao655-admin/rulesets/ad08ccca-1717-4e0d-882c-928d826c3115","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    // --- COLEÇÕES PÚBLICAS (leitura sem login) ---\n\n    // Agenda: exibida em páginas públicas (agendaregiao655.html, etc.)\n    match /agenda/{docId} {\n      allow read: if true;\n      allow write: if isAuthenticated();\n    }\n\n    // Inscrições Dia das Crianças: públicas\n    match /diadascriancas_inscricoes/{docId} {\n      allow read, write: if true;\n    }\n\n    // Eventos: exibidos em páginas públicas\n    match /eventos/{docId} {\n      allow read: if true;\n      allow write: if true;\n\n      // Inscrições do evento (público pode criar, organizadores gerenciam)\n      match /inscricoes/{inscricaoId} {\n        allow read, write: if true;\n      }\n\n      // Despesas do evento\n      match /despesas/{despesaId} {\n        allow read, write: if true;\n      }\n\n      // Log de auditoria financeira (imutável contra edições, mas permite exclusão ao limpar evento)\n      match /logs_financeiros/{logId} {\n        allow read, create: if true;\n        allow update: if false;\n        allow delete: if true;\n      }\n    }\n\n    // Igrejas: lidas na página pública de presença\n    match /igrejas/{docId} {\n      allow read: if true;\n      allow write: if isAuthenticated();\n    }\n\n    // Pastores: lidos na página pública de presença\n    match /pastores/{docId} {\n      allow read: if true;\n      allow write: if isAuthenticated();\n    }\n\n    // Seminários: lidos na página pública que gera os links do Roteiro\n    // do Facilitador (cidadania2026). Escrita continua só autenticada.\n    match /seminarios/{docId} {\n      allow read: if true;\n      allow write: if isAuthenticated();\n    }\n\n    // Configurações: layout_login e mini_portal são públicos\n    match /configuracoes/{docId} {\n      allow read: if docId == 'layout_login' || docId == 'mini_portal' || isAuthenticated();\n      allow write: if isAuthenticated();\n    }\n\n    // --- PRESENÇAS: leitura e escrita públicas com validação de campos ---\n    // A página presencareg655.html é acessível sem login\n    match /presencas/{docId} {\n      allow read: if true;\n      allow create: if request.resource.data.keys().hasAll(['nome', 'igreja', 'eventoId', 'status', 'declaracao'])\n                    && request.resource.data.declaracao == 'Sim'\n                    && request.resource.data.status in ['Presente', 'Justificado', 'Ausente'];\n      allow update: if request.resource.data.keys().hasAll(['nome', 'igreja', 'eventoId', 'status', 'declaracao'])\n                    && request.resource.data.declaracao == 'Sim'\n                    && request.resource.data.status in ['Presente', 'Justificado', 'Ausente'];\n      allow delete: if isAuthenticated();\n    }\n\n    // --- COLEÇÕES PRIVADAS (requerem autenticação) ---\n\n    // Logs de Auditoria do Sistema: autenticado pode criar e ler; imutável (sem edição nem exclusão)\n    match /logs_atividades/{docId} {\n      allow read, create: if isAuthenticated();\n      allow update: if false;\n      allow delete: if false;\n    }\n\n    match /usuarios/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    match /recibos/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    // Números de recibos cancelados (excluídos): registro permanente, nunca reutilizados.\n    // Pode ser lido e criado; não pode ser alterado nem apagado.\n    match /recibos_numeros_cancelados/{docId} {\n      allow read, create: if isAuthenticated();\n      allow update, delete: if false;\n    }\n\n    match /saldos_virada/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    match /pendencias_manuais/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    match /coordenadorias/{docId} {\n      allow read: if true;\n      allow write: if isAuthenticated();\n    }\n\n    match /avisos/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    match /avisos_ciencia/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    match /checklist_caixa/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    match /checklist_observacoes/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    match /checklist_sgaf/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    match /coordenadores_cidadania/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    match /devolucao_9018/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    // Presenças de Evento Aberto: escrita pública com validação\n    match /presencas_evento_aberto/{docId} {\n      allow read: if true;\n      allow create: if request.resource.data.keys().hasAll(['eventoId', 'igrejaNome', 'qtdPessoas', 'nomeRegistrador'])\n                    && request.resource.data.qtdPessoas is number\n                    && request.resource.data.qtdPessoas >= 1;\n      allow update: if isAuthenticated();\n      allow delete: if isAuthenticated();\n    }\n\n    // Pedidos da Campanha Projeto de Vida 2027\n    // Pedidos encerrados em 05/Nov: criação de novos pedidos bloqueada.\n    // Leitura, edição (ex.: marcar pago) e exclusão continuam liberadas.\n    match /pedidos_campanha_2027/{docId} {\n      allow read, update, delete: if isAuthenticated();\n      allow create: if false;\n    }\n\n    // --- VATHOS 2027 ---\n\n    // Configurações do evento VATHOS 2027 (lotes, termos, flags \"A definir\", gestores)\n    match /vathos_2027_config/{docId} {\n      allow read, write: if true;\n    }\n\n    // Inscrições VATHOS 2027 (portal público consulta/cria/atualiza por CPF; administração autenticada ou via gestor)\n    match /vathos_2027_inscricoes/{cpfId} {\n      allow read: if true;\n      allow create: if request.resource.data.keys().hasAll(['cpf', 'nomeCompleto', 'modalidade', 'statusCadastro', 'statusParticipacao'])\n                    && request.resource.data.cpf is string\n                    && request.resource.data.cpf.size() == 11;\n      allow update: if (request.resource.data.cpf == resource.data.cpf) || isAuthenticated();\n      allow delete: if true;\n    }\n\n    // Fichas de Saúde VATHOS 2027 (separadas das inscrições para privacidade na listagem de líderes)\n    match /vathos_2027_fichas_saude/{cpfId} {\n      allow read: if true;\n      allow create, update: if request.resource.data.keys().hasAll(['cpf'])\n                            && request.resource.data.cpf is string\n                            && request.resource.data.cpf.size() == 11;\n      allow delete: if true;\n    }\n\n    // Pagamentos individuais VATHOS 2027\n    match /vathos_2027_pagamentos/{pagamentoId} {\n      allow read: if true;\n      allow create: if request.resource.data.keys().hasAll(['cpfParticipante', 'forma', 'valorDestinadoInscricao', 'statusConferencia'])\n                    && request.resource.data.valorDestinadoInscricao is number\n                    && request.resource.data.valorDestinadoInscricao >= 0;\n      allow update: if true;\n      allow delete: if true;\n    }\n\n    // Acertos financeiros coletivos/igreja VATHOS 2027\n    match /vathos_2027_acertos/{acertoId} {\n      allow read, create, update: if true;\n      allow delete: if true;\n    }\n\n    // Despesas do evento VATHOS 2027 (custos da chácara, som, alimentação, notas fiscais, etc.)\n    match /vathos_2027_despesas/{despesaId} {\n      allow read, create, update: if true;\n      allow delete: if true;\n    }\n\n    // Trilha de auditoria imutável VATHOS 2027\n    match /vathos_2027_auditoria/{logId} {\n      allow read, create: if true;\n      allow update, delete: if false;\n    }\n\n    // Qualquer outra coleção não listada: requer autenticação\n    match /{collection}/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-11-18T03:36:02.430879Z","metadata":{"services":["cloud.firestore"]}}
